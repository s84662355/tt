const (
	TypeLen    int = 1
	RandKeyLen int = 24
	KeyLenLen  int = 4
	DataLenLen int = 4
)

var ConnHaveCloseErr = errors.New("连接已经关闭")

var atomicInt atomic.Uint64

type MessageType uint8

const (
	Connect MessageType = 1
	Msg     MessageType = 2
	Close   MessageType = 3
)

type Message struct {
	RandKey string
	Key     string
	Data    []byte
	Type    MessageType
	done    chan error
}

type WriteCloser struct {
	conn      *Conn
	key       string
	randKey   string
	ctx       context.Context
	cancel    context.CancelFunc
	closeDo   sync.Once
	finishDo  sync.Once
	finishErr error
}

func NewWriteCloser(key string, conn *Conn) *WriteCloser {
	randKey := fmt.Sprintf("%24s", fmt.Sprintf("%s%s", newRandomKey(), key)) // 固定长度24
	w := &WriteCloser{
		conn:    conn,
		key:     key,
		randKey: randKey,
	}
	w.ctx, w.cancel = context.WithCancel(context.Background())
	return w
}

func (w *WriteCloser) finish() error {
	w.finishDo.Do(func() {
		w.finishErr = w.conn.sendConnect(w.randKey, w.key)
	})
	return w.finishErr
}

func (w *WriteCloser) Write(p []byte) (n int, err error) {
	err = w.conn.send(w.ctx, w.randKey, w.key, p)
	if err == nil {
		n = len(p)
	}
	return
}

func (w *WriteCloser) Close() error {
	w.closeDo.Do(func() {
		w.cancel()
		w.conn.closeWriter(w.key)
	})
	return nil
}

type Reader struct {
	randKey string
	key     string
	data    []byte
	rWMutex sync.RWMutex
	dataQ   Queue[[]byte]
}

func NewReader(randKey, key string) *Reader {
	r := &Reader{
		randKey: randKey,
		key:     key,
		data:    make([]byte, 0, 1024),
		dataQ:   NewNQueue[[]byte](),
	}
	return r
}

func (r *Reader) Read(p []byte) (n int, err error) {
	r.rWMutex.Lock()
	dataLen := len(r.data)
	if dataLen > 0 {
		if dataLen > len(p) {
			n = copy(p, r.data[:len(p)])
			r.data = r.data[len(p):]
			r.rWMutex.Unlock()
			return
		} else {
			n = copy(p, r.data)
			r.data = r.data[:0]
			r.rWMutex.Unlock()
			return
		}
	}
	r.rWMutex.Unlock()

	for {
		if value, ok, isClose := r.dataQ.DequeueWait(); ok {

			r.data = append(r.data, value...)
			r.rWMutex.Lock()
			dataLen := len(r.data)
			if dataLen > 0 {
				if dataLen > len(p) {
					n = copy(p, r.data[:len(p)])
					r.data = r.data[len(p):]
					r.rWMutex.Unlock()
					return
				} else {
					n = copy(p, r.data)
					r.data = r.data[:0]
					r.rWMutex.Unlock()
					return
				}
			}
			r.rWMutex.Unlock()
		} else if isClose {
			return 0, io.EOF
		}
	}
}

func (r *Reader) write(p []byte) (err error) {
	return r.dataQ.Enqueue(p)
}

func (r *Reader) Close() error {
	r.dataQ.Close()
	return nil
}

// Conn 是你需要实现的一种连接类型，它支持下面描述的若干接口；
// 为了实现这些接口，你需要设计一个基于 TCP 的简单协议；
type Conn struct {
	c              net.Conn
	closeDo        sync.Once
	msgChan        chan *Message
	ctx            context.Context
	cancel         context.CancelFunc
	rWMutex        sync.RWMutex
	writeCloserMap map[string]*WriteCloser

	rMutex    sync.RWMutex
	readerMap map[string]*Reader
	done      chan struct{}
	readerQ   Queue[*Reader]
}

// NewConn 从一个 TCP 连接得到一个你实现的连接对象
func NewConn(c net.Conn) *Conn {
	conn := &Conn{
		c:              c,
		msgChan:        make(chan *Message),
		writeCloserMap: make(map[string]*WriteCloser),
		readerMap:      make(map[string]*Reader),
		readerQ:        NewNQueue[*Reader](),
		done:           make(chan struct{}),
	}
	conn.ctx, conn.cancel = context.WithCancel(context.Background())
	go func() {
		var wg sync.WaitGroup
		wg.Add(2)
		defer func() {
			wg.Wait()
			conn.readerQ.Close()

			conn.rMutex.Lock()
			for _, r := range conn.readerMap {
				r.Close()
			}
			conn.readerMap = nil
			conn.rMutex.Unlock()

			close(conn.done)
		}()
		go func() {
			defer wg.Done()
			conn.handleSendMsg()
			conn.c.Close()
		}()
		go func() {
			defer wg.Done()
			conn.handleReadMsg()
			conn.cancel()
		}()
	}()
	return conn
}

func (conn *Conn) handleReadMsg() {
	typeBuf := make([]byte, TypeLen)
	randKeyBuf := make([]byte, RandKeyLen)
	keyLenBuf := make([]byte, KeyLenLen)
	dataLenBuf := make([]byte, DataLenLen)

	for {

		if _, err := io.ReadFull(conn.c, typeBuf); err != nil {
			return
		}
		if _, err := io.ReadFull(conn.c, randKeyBuf); err != nil {
			return
		}

		if _, err := io.ReadFull(conn.c, keyLenBuf); err != nil {
			return
		}

		dec32 := binary.BigEndian.Uint32(keyLenBuf)

		keyBuf := make([]byte, dec32)

		if _, err := io.ReadFull(conn.c, keyBuf); err != nil {
			return
		}

		key := string(keyBuf)
		randKey := string(randKeyBuf)

		switch MessageType(typeBuf[0]) {
		case Connect:

			r := NewReader(randKey, key)
			conn.rMutex.Lock()
			if conn.readerMap != nil {
				if _, ok := conn.readerMap[randKey]; ok {
					conn.rMutex.Unlock()
					break
				}
				conn.readerMap[randKey] = r
			}
			conn.rMutex.Unlock()
			conn.readerQ.Enqueue(r)

		case Msg:
			if _, err := io.ReadFull(conn.c, dataLenBuf); err != nil {
				return
			}

			dec32 := binary.BigEndian.Uint32(dataLenBuf)
			dataBuf := make([]byte, dec32)
			if _, err := io.ReadFull(conn.c, dataBuf); err != nil {
				return
			}

			var r *Reader
			conn.rMutex.RLock()
			if conn.readerMap != nil {
				r = conn.readerMap[randKey]
			}
			conn.rMutex.RUnlock()

			if r != nil {
				r.write(dataBuf)
			}
		case Close:

			var r *Reader
			conn.rMutex.Lock()
			if conn.readerMap != nil {
				r = conn.readerMap[randKey]
				delete(conn.readerMap, randKey)
			}
			conn.rMutex.Unlock()
			if r != nil {
				r.Close()
			}
		default:

			return
		}

	}
}

func (conn *Conn) handleSendMsg() {
	for {
		select {
		case <-conn.ctx.Done():
			conn.c.Close()
			return
		case msg := <-conn.msgChan:

			if msg != nil {
				buf := make([]byte, TypeLen+RandKeyLen)
				buf[0] = byte(msg.Type)
				copy(buf[TypeLen:TypeLen+RandKeyLen], []byte(msg.RandKey))

				b32 := make([]byte, KeyLenLen) // 长度必须匹配类型字节数
				binary.BigEndian.PutUint32(b32, uint32(len(msg.Key)))

				buf = append(buf, b32...)
				buf = append(buf, []byte(msg.Key)...)

				switch msg.Type {
				case Connect:
					dataLen := len(buf)
					for {
						n, err := conn.c.Write(buf)
						if err != nil {
							msg.done <- err
							continue
						}
						dataLen -= n
						if dataLen == 0 {
							break
						}
					}
					msg.done <- nil

				case Msg:
					b32 := make([]byte, DataLenLen) // 长度必须匹配类型字节数
					binary.BigEndian.PutUint32(b32, uint32(len(msg.Data)))
					buf = append(buf, b32...)
					buf = append(buf, msg.Data...)

					dataLen := len(buf)
					for {
						n, err := conn.c.Write(buf)
						if err != nil {
							msg.done <- err
							continue
						}
						dataLen -= n
						if dataLen == 0 {
							break
						}
					}
					msg.done <- nil

				case Close:
					dataLen := len(buf)
					for {
						n, err := conn.c.Write(buf)
						if err != nil {
							msg.done <- err
							continue
						}
						dataLen -= n
						if dataLen == 0 {
							break
						}
					}
					msg.done <- nil
				default:
					msg.done <- nil
					return
				}
			}
		}
	}
}

func (conn *Conn) closeWriter(key string) {
	conn.rWMutex.Lock()
	w := conn.writeCloserMap[key]
	delete(conn.writeCloserMap, key)
	conn.rWMutex.Unlock()
	m := &Message{
		RandKey: w.randKey,
		Key:     w.key,
		Type:    Close,
		done:    make(chan error),
	}
	select {
	case <-conn.ctx.Done():
		return
	case conn.msgChan <- m:
		<-m.done
	}
	return
}

func (conn *Conn) send(ctx context.Context, randKey, key string, data []byte) (err error) {
	m := &Message{
		RandKey: randKey,
		Key:     key,
		Data:    data,
		Type:    Msg,
		done:    make(chan error),
	}
	select {
	case <-ctx.Done():
		return ctx.Err()
	case <-conn.ctx.Done():
		return conn.ctx.Err()
	case conn.msgChan <- m:
		err = <-m.done
	}
	return
}

func (conn *Conn) sendConnect(randKey, key string) (err error) {
	m := &Message{
		RandKey: randKey,
		Key:     key,
		Type:    Connect,
		done:    make(chan error),
	}
	select {
	case <-conn.ctx.Done():
		return conn.ctx.Err()
	case conn.msgChan <- m:
		err = <-m.done
	}
	return
}

// Send 传入一个 key 表示发送者将要传输的数据对应的标识；
// 返回 writer 可供发送者分多次写入大量该 key 对应的数据；
// 当发送者已将该 key 对应的所有数据写入后，调用 writer.Close 告知接收者：该 key 的数据已经完全写入；
func (conn *Conn) Send(key string) (writer io.WriteCloser, err error) {
	conn.rWMutex.Lock()
	var w *WriteCloser = nil
	if ww, ok := conn.writeCloserMap[key]; ok {
		w = ww
	} else {
		w = NewWriteCloser(key, conn)
		conn.writeCloserMap[key] = w
	}
	conn.rWMutex.Unlock()

	err = w.finish()
	if err != nil {
		w.Close()
		conn.rWMutex.Lock()
		if ww, ok := conn.writeCloserMap[key]; ok {
			if ww == w {
				delete(conn.writeCloserMap, key)
			}
			conn.rWMutex.Unlock()
			return nil, ConnHaveCloseErr
		}

		conn.rWMutex.Unlock()
	}

	return w, nil
}

// Receive 返回一个 key 表示接收者将要接收到的数据对应的标识；
// 返回的 reader 可供接收者多次读取该 key 对应的数据；
// 当 reader 返回 io.EOF 错误时，表示接收者已经完整接收该 key 对应的数据；
func (conn *Conn) Receive() (key string, reader io.Reader, err error) {
	if value, ok, isClose := conn.readerQ.DequeueWait(); ok {
		return value.key, value, nil
	} else if isClose {
		return "", nil, io.EOF
	}
	return "", nil, nil
}

// Close 关闭你实现的连接对象及其底层的 TCP 连接
func (conn *Conn) Close() {
	conn.cancel()
	conn.readerQ.Close()
	for range conn.done {
		/* code */
	}
}

